# Example Nginx site for a Linux server (VPS / cloud).
# Copy to /etc/nginx/sites-available/carlton-landing, update server_name and paths,
# then: ln -s ../sites-available/carlton-landing /etc/nginx/sites-enabled/ && nginx -t && systemctl reload nginx
# Add HTTPS with: certbot --nginx -d franchise.example.com

server {
    listen 80;
    server_name franchise.example.com;

    # Static landing page (contents of release/frontend)
    root /var/www/carlton-landing/frontend;
    index index.html;

    location / {
        try_files $uri $uri.html $uri/ =404;
    }

    # Lead API (release/backend, running on PORT from .env)
    location /api/ {
        proxy_pass http://127.0.0.1:4000;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        client_max_body_size 32k;
    }

    location ~* \.(png|jpg|jpeg|webp|svg|ico)$ {
        expires 30d;
        add_header Cache-Control "public";
    }
}
