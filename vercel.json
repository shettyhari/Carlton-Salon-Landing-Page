{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "npm install && npm --prefix backend install --omit=dev",
  "buildCommand": "echo \"No build step: frontend/ is served as static files\"",
  "outputDirectory": "frontend",
  "functions": {
    "api/index.js": {
      "includeFiles": "database/migrations/**",
      "maxDuration": 10
    }
  },
  "rewrites": [
    { "source": "/api/:path*", "destination": "/api/index" }
  ]
}
