# Copy this file to .env and fill in the values. Never commit .env.

PORT=4000

# ---- Database ----
# sqlite (default, for local testing) | mysql | postgres
DB_CLIENT=sqlite

# SQLite: path to the database file (relative to backend/)
DB_FILE=data/leads.sqlite

# MySQL / PostgreSQL: either a full connection URL...
# DATABASE_URL=mysql://user:password@host:3306/carlton_leads
# DATABASE_URL=postgres://user:password@host:5432/carlton_leads
# ...or individual settings
DB_HOST=127.0.0.1
DB_PORT=
DB_USER=
DB_PASSWORD=
DB_NAME=carlton_leads
# PostgreSQL on a managed host (Render, Supabase, RDS) usually needs SSL
DB_SSL=false

# Create/update the leads table automatically on start
AUTO_MIGRATE=true

# ---- Frontend ----
# Serve the landing page from this server (true) or host it separately (false)
SERVE_FRONTEND=true
# Only needed if the frontend is on a different domain, comma-separated
# CORS_ORIGINS=https://franchise.carltonwellnessgroup.com

# Set to false if the server is NOT behind Nginx or a hosting proxy
TRUST_PROXY=true
